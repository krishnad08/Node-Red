    {
        "id": "47529364f4420122",
        "type": "function",
        "z": "b4f7549c6815a4e4",
        "name": "Handle Logging & Increment",
        "func": "let date = new Date();\nlet time_now = date.getTime();\nlet docker_restarts = global.get('masen_restart_monitor');\n// If never been rebooted or 12 hours have passed since last reboot\nif (msg.payload == \"\" || parseInt(msg.payload) < (time_now - 43200000)){\n    if(Object.hasOwn(msg, 'bypass')){\n        msg.payload = time_now + \" - Rebooting Gateway bypassed docker restart - HTTP\";\n        msg.out = \"reboot\";\n        return msg;\n    }\n    node.warn(docker_restarts);\n    // If docker_restarts has more than three records remove the first one\n    // A restart requirement would have been caught when the previous was added\n   // if (docker_restarts.length > 1) {\n    if (docker_restarts.length > 2) {\n        docker_restarts.shift();\n    }\n    docker_restarts.push(time_now);\n\n    // Check for three alements and first element is less than two hours ago\n   // if (docker_restarts.length >= 2 && docker_restarts[1] - docker_restarts[0] < 900000) {\n   if (docker_restarts.length >= 3 && docker_restarts[2] - docker_restarts[0] < 7200000) {\n        msg.payload = time_now + \" - Rebooting Gateway\";\n        msg.out = \"reboot\";\n    } else {\n        msg.payload = time_now + \" - Restarting Docker\";\n        msg.out = \"restart_docker\";\n    }\n    global.set('masen_restart_monitor', docker_restarts);\n    return msg;\n}else{\n    msg.payload = time_now + \" - 12 hour ignore period\";\n    return msg;\n}\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1340,
        "y": 280,
