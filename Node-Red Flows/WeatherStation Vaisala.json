    {
        "id": "6a5cc9128275f1e8",
        "type": "function",
        "z": "cb30fe2682f01f90",
        "name": "Get Hour",
        "func": "// Get the timestamp from the message payload (milliseconds)\nlet timestamp_ms = msg.payload;\n\n// Convert to seconds\nlet timestamp_s = timestamp_ms / 1000;\n\n// Convert to Date object\nlet date = new Date(timestamp_s * 1000);  // Convert to JavaScript Date object\n\n// Extract the hour\nlet hour = date.getUTCHours();  // Use getHours() for local time\n\n// Set the output payload\nmsg.payload = hour;\n\nreturn msg;",
