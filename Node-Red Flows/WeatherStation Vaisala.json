    {
        "id": "35ad7fcd4d8c5d11",
        "type": "function",
        "z": "cb30fe2682f01f90",
        "name": "10 min Filter on 2 Minute Mark",
        "func": "// Get the timestamp from the message payload (milliseconds)\nlet timestamp_ms = msg.payload;\n\n// Convert to seconds\nlet timestamp_s = timestamp_ms / 1000;\n\n// Convert to Date object\nlet date = new Date(timestamp_s * 1000);  // Convert to JavaScript Date object\n\n// Extract the minutes\nlet minutes = date.getUTCMinutes();  // Use getMinutes() for local time\n\n// Define allowed minute marks\nlet allowedMinutes = [2, 12, 22, 32, 42, 52];\n\n// Check if the current minute is in the allowed list\nif (allowedMinutes.includes(minutes)) {\n    msg.payload = minutes;  // Send the message only if it matches\n    return msg;\n} else {\n    return null;  // Stop processing if the minute is not in the list\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
